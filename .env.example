# FinGuide AI Environment Variables Setup
# Copy this file to '.env' and fill in your keys.

# Google Gemini API Key (Optional: Falls back to Mock AI Mode if empty)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional: Falls back to Mock AI Mode if empty)
OPENAI_API_KEY=your_openai_api_key_here
